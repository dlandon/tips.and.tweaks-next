<!--
Get the plugin bundle.
-->
<FILE Name="/boot/config/plugins/&plugin;/&name;-&version;.tgz">
<URL>"&tgzURL;/&name;-&version;.tgz"</URL>
<MD5>&MD5;</MD5>
</FILE>

<!--
The 'pre-install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
#
# The previous tips and tweaks plugin cannot be installed.
#
if [ -f /boot/config/plugins/&plugin;.plg ] ; then
echo ""
echo "-----------------------------------------------------------"
echo " &name; has not been installed!"
echo ""
echo " The previous Tips and Tweaks plugin is installed."
echo ""
echo " You must uninstall the Tips and Tweaks plugin"
echo " before installing Tips and Tweaks - Next."
echo ""
echo "-----------------------------------------------------------"
echo ""
exit 1
fi
#
# Validate the bundle before changing the installed plugin.
#
if ! tar -tf "/boot/config/plugins/&plugin;/&name;-&version;.tgz" >/dev/null 2>&amp;1; then
	echo "ERROR: &name; bundle is missing or invalid. Installation aborted."
	exit 1
fi

#
# Save the kill tasks event before updating the plugin.
#
if [ -f /usr/local/emhttp/plugins/&plugin;/event/stopping_svcs ]; then
	mv -f /usr/local/emhttp/plugins/&plugin;/event/stopping_svcs /tmp/&plugin;.stopping_svcs
fi

#
# Remove emhttp files so we can re-install.
#
rm -rf /usr/local/emhttp/plugins/&plugin;/* 2>/dev/null

#
# Remove old 'bundle' files.
#
for bundle in /boot/config/plugins/&plugin;/&name;*.tgz; do
	if [[ -f "$bundle" &amp;&amp; "$bundle" != "/boot/config/plugins/&plugin;/&name;-&version;.tgz" ]]; then
		rm -f -- "$bundle"
	fi
done
</INLINE>
</FILE>

<!--
Install the plugin bundle.
-->
<FILE Run="/bin/bash">
<INLINE>
#
# Install the 'bundle'.
#
if ! tar -xf "/boot/config/plugins/&plugin;/&name;-&version;.tgz" -C /usr/local/emhttp/plugins; then
	echo "ERROR: Unable to extract &name; bundle. Installation aborted."
	exit 1
fi
</INLINE>
</FILE>

<FILE Name="/boot/config/plugins/&plugin;/&plugin;.cfg">
<INLINE>
<![CDATA[
]]>
</INLINE>
</FILE>

<!--
The 'post-install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
#
# Restore the kill tasks event
#
if [ -f /tmp/&plugin;.stopping_svcs ]; then
	mkdir -p /usr/local/emhttp/plugins/&plugin;/event/
	mv -f /tmp/&plugin;.stopping_svcs /usr/local/emhttp/plugins/&plugin;/event/stopping_svcs
fi

#
# Create a symlink to tips.and.tweaks script.
#
ln -sf /usr/local/emhttp/plugins/&plugin;/scripts/rc.tweaks /usr/local/sbin

#
# Remove legacy syslog archive hook from rc.local_shutdown.
#
shutdown_file="/etc/rc.d/rc.local_shutdown"
tmp_file="/tmp/rc.local_shutdown.$$"

if [ -f "$shutdown_file" ]; then
	if grep -q "^#archive_logs_start$" "$shutdown_file"; then
		if ! sed '/^#archive_logs_start$/,/^#archive_logs_end$/d' "$shutdown_file" > "$tmp_file"; then
			rm -f "$tmp_file"
			echo "ERROR: Unable to prepare legacy syslog hook removal."
			exit 1
		fi

		if ! cat "$tmp_file" > "$shutdown_file"; then
			rm -f "$tmp_file"
			echo "ERROR: Unable to update $shutdown_file."
			exit 1
		fi

		rm -f "$tmp_file"
	fi
fi

echo ""
echo "-----------------------------------------------------------"
echo " &name; is installed."
echo " Copyright 2016-2026 &author;"
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
#
# Remove the hook for log archiving
#
/usr/local/emhttp/plugins/&plugin;/scripts/rc.tweaks remove_syslog

#
# Remove dynamix set governor cron file.
#
rm -f /boot/config/plugins/dynamix/cpu_governor.cron

#
# Remove dynamix set boost cron file
#
rm -f /boot/config/plugins/dynamix/cpu_turbo_boost.cron

#
# Reload dynamix crons.
#
/usr/local/sbin/update_cron

#
# Remove symlink to rc.tweaks script
#
rm -f /usr/local/sbin/rc.tweaks

#
# Remove all plugin files.
#
rm -rf /usr/local/emhttp/plugins/&plugin; 2>/dev/null

#
# Remove the tips and tweaks 'bundle' so it will be downloaded if re-installed.
#
rm -f "/boot/config/plugins/&plugin;/&name;-&version;.tgz"

echo "Removing packages..."

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been removed."
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
